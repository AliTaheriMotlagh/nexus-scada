{
  "name": "@nexus/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../shared --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
