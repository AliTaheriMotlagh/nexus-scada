  },
  "dependencies": {
    "express": "^5.2.1",
    "mqtt": "^5.16.0",
    "sucrase": "^3.35.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2"
  }
}
